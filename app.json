{
  "expo": {
    "name": "KanBağı",
    "slug": "kanbagi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enespala.kanbagi",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KanBağı, yakınınızdaki acil kan ihtiyaçlarını bulmak ve eşleştirmek için konumunuzu kullanır.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KanBağı, uygulama arka plandayken bile 100km çevrenizdeki acil kan ilanlarından anında haberdar olmanız için konumunuzu kullanır."
      }
    },
    "android": {
      "package": "com.enespala.kanbagi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c8cd4ba6-57b3-4ba5-bd19-e9b94f4bb117"
      }
    },
    "owner": "enespala07s-team",
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-notifications"
    ]
  }
}
